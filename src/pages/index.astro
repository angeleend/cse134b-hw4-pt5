---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import japanImg from '@/assets/japan.JPG';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<div class="hero-image">
				<Image src={ japanImg } alt="Picture of a bridge in Osaka during sunset with a saturated blue sky" width={800} height={533} />
			</div>
			<h1>hi ______!</h1>
			<p>
				welcome to my blog! here, i share fun content from my daily life, 
				such as events and my quarterly fun hangouts. i like to show off 
				(aesthetic?) pictures of my food, cool scenery, and other miscellaneous stuff.
			</p>
		</main>
		<Footer />
	</body>
</html>
